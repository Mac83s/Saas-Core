{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saas-core.local/content-operations/content-change-set.v1.schema.json",
  "title": "Content change set v1",
  "description": "One proposed change to one content surface, as SeoContentRank sends it to SaaS Core. Never a general JSON Patch: the command list is the audit record of what an automation changed, which is the only thing that makes an autonomous publication traceable afterwards.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "idempotency_key",
    "target",
    "base",
    "rationale",
    "commands"
  ],
  "properties": {
    "contract_version": {
      "description": "The contract the sender speaks. A server that does not implement it refuses the change set rather than guessing.",
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "description": "Stable across retries of the same intent, different for a recomputed proposal. A retry must never create a second draft.",
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "target": { "$ref": "#/$defs/target" },
    "base": { "$ref": "#/$defs/base" },
    "rationale": { "$ref": "#/$defs/rationale" },
    "commands": {
      "description": "Applied as one set against the base version, not sequentially. Every position refers to the state at base.version.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "locale": { "type": "string", "enum": ["pl", "en"] },
    "position": { "type": "integer", "minimum": 0, "maximum": 200 },
    "target": {
      "description": "Exactly one surface. The two surfaces of ADR-035 §1 are addressed differently because they publish differently: a site page rides the atomic site snapshot, an entry publishes on its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "site_id", "locale"],
      "properties": {
        "kind": { "type": "string", "enum": ["site_page", "content_entry"] },
        "site_id": { "$ref": "#/$defs/uuid" },
        "page_id": { "$ref": "#/$defs/uuid" },
        "collection_id": { "$ref": "#/$defs/uuid" },
        "entry_id": { "$ref": "#/$defs/uuid" },
        "locale": { "$ref": "#/$defs/locale" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "site_page" } } },
          "then": {
            "required": ["page_id"],
            "properties": {
              "page_id": { "$ref": "#/$defs/uuid" },
              "collection_id": false,
              "entry_id": false
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "content_entry" } } },
          "then": {
            "required": ["collection_id"],
            "properties": {
              "collection_id": { "$ref": "#/$defs/uuid" },
              "page_id": false
            }
          }
        }
      ]
    },
    "base": {
      "description": "What the sender was looking at. Both halves are required: the version is what the server locks against, the hash is what proves the sender read the same bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "snapshot_hash", "observed_at"],
      "properties": {
        "version": { "type": "integer", "minimum": 0 },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "rationale": {
      "description": "Why this change was proposed. Required in every mode, including autonomous: a published change nobody approved is exactly the one whose reasoning has to survive.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "risk", "sources"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "expected_outcome": { "type": "string", "maxLength": 2000 },
        "sources": {
          "description": "Where the recommendation came from. An empty list is refused: a proposal with no source is an opinion presented as an analysis.",
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference", "observed_at"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "seositeaudit",
                  "search_console",
                  "keyword_research",
                  "competitor_analysis",
                  "editorial"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "observed_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "command": {
      "oneOf": [
        { "$ref": "#/$defs/commandPageCreate" },
        { "$ref": "#/$defs/commandEntryCreate" },
        { "$ref": "#/$defs/commandTranslationUpdate" },
        { "$ref": "#/$defs/commandBlockInsert" },
        { "$ref": "#/$defs/commandBlockReplace" },
        { "$ref": "#/$defs/commandBlockRemove" },
        { "$ref": "#/$defs/commandBlockReorder" },
        { "$ref": "#/$defs/commandInternalLinkAdd" },
        { "$ref": "#/$defs/commandPublicationSchedule" }
      ]
    },
    "block": {
      "description": "A controlled block. `data` is validated a second time against the canonical site-block schema for that type and version; this schema only fixes the envelope.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "data"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "schema_version": { "type": "integer", "minimum": 1 },
        "data": { "type": "object" }
      }
    },
    "commandPageCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "key", "name", "page_type"],
      "properties": {
        "command": { "const": "page.create" },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "page_type": {
          "type": "string",
          "enum": [
            "homepage",
            "landing",
            "service",
            "about",
            "contact",
            "legal",
            "article_index",
            "article"
          ]
        }
      }
    },
    "commandEntryCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "slug", "title"],
      "properties": {
        "command": { "const": "entry.create" },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "commandTranslationUpdate": {
      "description": "SEO metadata only. The slug is deliberately absent: moving a published address costs whatever ranking it had, so it stays a human-only, separately audited workflow.",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "fields"],
      "properties": {
        "command": { "const": "translation.update" },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "title": { "type": "string", "maxLength": 200 },
            "description": { "type": "string", "maxLength": 500 },
            "social_title": { "type": "string", "maxLength": 200 },
            "social_description": { "type": "string", "maxLength": 500 }
          }
        }
      }
    },
    "commandBlockInsert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "position", "block"],
      "properties": {
        "command": { "const": "block.insert" },
        "position": { "$ref": "#/$defs/position" },
        "block": { "$ref": "#/$defs/block" }
      }
    },
    "commandBlockReplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "position", "block"],
      "properties": {
        "command": { "const": "block.replace" },
        "position": { "$ref": "#/$defs/position" },
        "block": { "$ref": "#/$defs/block" }
      }
    },
    "commandBlockRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "position"],
      "properties": {
        "command": { "const": "block.remove" },
        "position": { "$ref": "#/$defs/position" }
      }
    },
    "commandBlockReorder": {
      "description": "The complete new order, given as base positions. Pairwise moves would depend on the order the commands were applied in, which is exactly the ambiguity this contract exists to avoid.",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "order"],
      "properties": {
        "command": { "const": "block.reorder" },
        "order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/position" }
        }
      }
    },
    "commandInternalLinkAdd": {
      "description": "A link to a path this site already publishes. The server checks the target resolves; a link to a page that does not exist yet is refused rather than created as a promise.",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "position", "target_path", "anchor_text"],
      "properties": {
        "command": { "const": "internal_link.add" },
        "position": { "$ref": "#/$defs/position" },
        "target_path": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9]+(?:-[a-z0-9]+)*/)*$",
          "maxLength": 300
        },
        "anchor_text": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "commandPublicationSchedule": {
      "description": "Asks for publication at a moment, not for publication now. Whether it happens at all still depends on the grant mode and the surface policy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "publish_at"],
      "properties": {
        "command": { "const": "publication.schedule" },
        "publish_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
