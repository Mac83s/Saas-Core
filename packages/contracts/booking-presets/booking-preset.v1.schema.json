{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saas-core.local/booking-presets/booking-preset.v1.schema.json",
  "title": "SaaS Core booking preset v1",
  "description": "Preset rezerwacji (ADR-072 §10): gotowa konfiguracja oferty jako dane. Zastosowanie kopiuje wartości do nowej, nieaktywnej oferty firmy z pochodzeniem (preset i wersja). Preset nie niesie kwot ani stawek podatku: zależą od waluty i kraju firmy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "readiness",
    "labels",
    "timeModel",
    "booked",
    "quantity",
    "confirmation",
    "place",
    "calendarSync"
  ],
  "properties": {
    "id": {
      "description": "Przestrzeń nazw i klucz: `core.` dla presetów rdzenia, własna przestrzeń produktu dla presetów z profilu.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "maxLength": 80
    },
    "version": { "type": "integer", "minimum": 1 },
    "readiness": {
      "description": "ready: rdzeń tej wersji przyjmuje rezerwacje tego presetu; dopiero taki preset musi nieść słownictwo, pola, dopłaty i uczestników. soon: firma widzi preset z etykietą „wkrótce” i może zapisać się na listę zainteresowanych (odpowiedź 14 a+b); niesie z planu nazwę, opis, model czasu i wartości z tabeli presetów, a reszta to propozycje agenta (ADR-072 §10). Zmiana na ready to nowa wersja presetu, wydana z kodem, który go obsługuje.",
      "enum": ["ready", "soon"]
    },
    "labels": { "$ref": "#/$defs/presetLabels" },
    "timeModel": {
      "description": "slot: termin z siatki wolnych startów; range: okres od–do; session: miejsca w wystąpieniu wydarzenia.",
      "enum": ["slot", "range", "session"]
    },
    "range": { "$ref": "#/$defs/range" },
    "session": { "$ref": "#/$defs/session" },
    "booked": { "$ref": "#/$defs/booked" },
    "quantity": {
      "description": "one: jedna osoba albo jednostka; units: N sztuk z grupy; seats: N miejsc w wystąpieniu.",
      "enum": ["one", "units", "seats"]
    },
    "participants": { "$ref": "#/$defs/participants" },
    "confirmation": {
      "description": "instant: od razu; on_request: firma akceptuje, termin wstrzymany do akceptacji; quote_request: firma wycenia zapytanie.",
      "enum": ["instant", "on_request", "quote_request"]
    },
    "place": {
      "description": "business: w miejscu firmy albo jednostki; customer: pod adresem klienta; online: rozmowa przez internet; pickup_return: odbiór i zwrot.",
      "enum": ["business", "customer", "online", "pickup_return"]
    },
    "price": { "$ref": "#/$defs/price" },
    "payment": { "$ref": "#/$defs/payment" },
    "cancellation": { "$ref": "#/$defs/cancellation" },
    "fields": {
      "description": "Pola formularza ponad dane standardowe. Wartości to dane klienta: nie trafiają do e-maili, logów ani historii zmian; pole consent zapisuje akceptację w dzienniku zgód, nie jako wartość (ADR-072 §8).",
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/field" }
    },
    "extras": {
      "description": "Podpowiedzi dopłat bez kwot: kwotę i stawkę VAT wpisuje firma.",
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/extra" }
    },
    "calendarSync": {
      "description": "Czy preset proponuje podpięcie kalendarzy portali (iCal, ADR-075). Synchronizacja jest dostępna niezależnie od tej flagi.",
      "type": "boolean"
    },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "requiredInputs": {
      "description": "Dane, których preset potrzebuje od firmy przed uruchomieniem oferty (np. season_dates, min_length, photos): konfigurator asystenta liczy z nich brakujące pytania (plan asystenta, A2). Klucze, nie teksty.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "catalogCategory": {
      "description": "Podpowiedź kategorii katalogu publicznego; musi istnieć w słowniku katalogu (ADR-053 §7). Zastosowanie pomija ją, gdy typ organizacji firmy jej nie ma (ADR-072 §10).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "pageTemplate": {
      "description": "Podpowiedź szablonu strony; musi istnieć w manifeście szablonów i nie być wycofany. Zastosowanie pomija ją, gdy typ organizacji firmy nie ma szablonu.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "readiness": { "const": "ready" } } },
      "then": {
        "required": ["participants", "fields", "extras", "vocabulary"],
        "properties": {
          "participants": {},
          "fields": {},
          "extras": {},
          "vocabulary": {}
        }
      }
    },
    {
      "if": { "properties": { "timeModel": { "const": "range" } } },
      "then": { "required": ["range"], "properties": { "range": {} } },
      "else": { "properties": { "range": false } }
    },
    {
      "if": { "properties": { "timeModel": { "const": "session" } } },
      "then": {
        "required": ["session"],
        "properties": {
          "session": {},
          "booked": {
            "type": "object",
            "properties": { "subject": { "const": "seat" } }
          },
          "quantity": { "const": "seats" }
        }
      },
      "else": {
        "properties": {
          "session": false,
          "booked": {
            "type": "object",
            "properties": { "subject": { "not": { "const": "seat" } } }
          },
          "quantity": { "not": { "const": "seats" } }
        }
      }
    },
    {
      "if": { "properties": { "quantity": { "const": "units" } } },
      "then": {
        "properties": {
          "booked": {
            "type": "object",
            "properties": { "subject": { "const": "unit_group" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 40
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 160 },
    "word": {
      "description": "Słowo do nagłówków i etykiet (mianownik), nie do wstawiania w zdania.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "localTime": {
      "description": "Godzina lokalna firmy HH:MM.",
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "localizedText": {
      "description": "Tekst w pl i en; kolejne języki treści opcjonalnie, tylko kody z rejestru packages/contracts/locales/registry.json (ADR-071 pkt 2; sprawdza test kontraktu, bo wzorzec przepuściłby np. cz).",
      "type": "object",
      "required": ["pl", "en"],
      "properties": {
        "pl": { "$ref": "#/$defs/text" },
        "en": { "$ref": "#/$defs/text" }
      },
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "$ref": "#/$defs/text" }
    },
    "presetLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "presetLabels": {
      "type": "object",
      "required": ["pl", "en"],
      "properties": {
        "pl": { "$ref": "#/$defs/presetLabel" },
        "en": { "$ref": "#/$defs/presetLabel" }
      },
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "$ref": "#/$defs/presetLabel" }
    },
    "terms": {
      "description": "Słownictwo panelu i strony: jednostka, rezerwacja, uczestnik i jednostka czasu, w liczbie pojedynczej i mnogiej.",
      "type": "object",
      "additionalProperties": false,
      "required": ["booking", "bookings", "participant", "participants"],
      "properties": {
        "unit": { "$ref": "#/$defs/word" },
        "units": { "$ref": "#/$defs/word" },
        "booking": { "$ref": "#/$defs/word" },
        "bookings": { "$ref": "#/$defs/word" },
        "participant": { "$ref": "#/$defs/word" },
        "participants": { "$ref": "#/$defs/word" },
        "timeUnit": { "$ref": "#/$defs/word" },
        "timeUnits": { "$ref": "#/$defs/word" }
      },
      "dependentRequired": {
        "unit": ["units"],
        "units": ["unit"],
        "timeUnit": ["timeUnits"],
        "timeUnits": ["timeUnit"]
      }
    },
    "vocabulary": {
      "type": "object",
      "required": ["pl", "en"],
      "properties": {
        "pl": { "$ref": "#/$defs/terms" },
        "en": { "$ref": "#/$defs/terms" }
      },
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "$ref": "#/$defs/terms" }
    },
    "range": {
      "description": "Okres od–do. Godziny początku i końca to zameldowanie i wymeldowanie dla nocy, odbiór i zwrot dla dnia; przeliczane na UTC w strefie firmy (ADR-072 §1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": {
        "unit": { "enum": ["night", "day", "hour"] },
        "startTime": { "$ref": "#/$defs/localTime" },
        "endTime": { "$ref": "#/$defs/localTime" },
        "rules": { "$ref": "#/$defs/rules" }
      },
      "dependentRequired": {
        "startTime": ["endTime"],
        "endTime": ["startTime"]
      },
      "if": { "properties": { "unit": { "const": "hour" } } },
      "then": { "properties": { "startTime": false, "endTime": false } }
    },
    "rules": {
      "description": "Domyślne reguły rezerwacji oferty (BookingRule bez dat, ADR-072 §5); długości w jednostkach czasu okresu.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "minLength": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "multiple": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "session": {
      "description": "recurring: wystąpienia z harmonogramu cyklicznego; dated: konkretne terminy; series: zapis na całą serię.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "waitlist"],
      "properties": {
        "schedule": { "enum": ["recurring", "dated", "series"] },
        "waitlist": { "type": "boolean" }
      }
    },
    "booked": {
      "description": "subject: kto lub co trzyma czas (osoba, jednostka, jednostka z grupy z doborem, miejsce w wystąpieniu). staff: required — osoba zawsze; optional — firma decyduje przy ofercie (staff_count 0 albo co najmniej 1), klient osoby nie wybiera; none — bez osoby (ADR-072 §2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "staff"],
      "properties": {
        "subject": { "enum": ["staff", "unit", "unit_group", "seat"] },
        "staff": { "enum": ["required", "optional", "none"] }
      },
      "allOf": [
        {
          "if": { "properties": { "subject": { "const": "staff" } } },
          "then": { "properties": { "staff": { "const": "required" } } }
        },
        {
          "if": { "properties": { "subject": { "const": "seat" } } },
          "then": { "properties": { "staff": { "const": "none" } } }
        }
      ]
    },
    "participants": {
      "description": "none: bez liczenia osób; count: liczba osób; categories: osoby w kategoriach z własną ceną. Liczący się do pojemności muszą zmieścić się w pojemności jednostki.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "count", "categories"] },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/participantCategory" }
        }
      },
      "if": { "properties": { "mode": { "const": "categories" } } },
      "then": {
        "required": ["categories"],
        "properties": { "categories": {} }
      },
      "else": { "properties": { "categories": false } }
    },
    "participantCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "countsTowardCapacity", "labels"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "countsTowardCapacity": { "type": "boolean" },
        "labels": { "$ref": "#/$defs/localizedText" }
      }
    },
    "price": {
      "description": "Podstawa ceny i to, od czego zwykle zależy. Kwoty wpisuje firma w swojej walucie.",
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "basis": {
          "enum": [
            "none",
            "per_booking",
            "per_time_unit",
            "per_person",
            "per_group"
          ]
        },
        "variesBy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["season", "weekday", "time_of_day"] }
        }
      },
      "if": { "properties": { "basis": { "const": "none" } } },
      "then": { "properties": { "variesBy": false } }
    },
    "payment": {
      "description": "Polityka płatności oferty (ADR-072 §8). Brak pola: preset nie podpowiada polityki. Wartości są podpowiedzią; po powstaniu rejestru ustawień platformy nadpisuje je operator (T23).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "policy": {
          "enum": ["none", "on_site", "transfer", "deposit", "full"]
        },
        "depositPercent": { "type": "integer", "minimum": 1, "maximum": 99 },
        "transferDueDays": {
          "description": "Ile dni klient ma na wpłatę przelewem, zanim rezerwacja wygaśnie.",
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "balanceDueDaysBefore": {
          "description": "Dopłata reszty tyle dni przed początkiem; brak pola przy zadatku: reszta na miejscu.",
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        },
        "securityDeposit": {
          "description": "Czy oferta zwykle pobiera kaucję (kwota firmy, nie przychód).",
          "type": "boolean"
        }
      },
      "dependentRequired": {
        "depositPercent": ["policy"],
        "transferDueDays": ["policy"],
        "balanceDueDaysBefore": ["policy"]
      },
      "allOf": [
        {
          "if": {
            "required": ["policy"],
            "properties": { "policy": { "not": { "const": "deposit" } } }
          },
          "then": {
            "properties": {
              "depositPercent": false,
              "balanceDueDaysBefore": false
            }
          }
        },
        {
          "if": {
            "required": ["policy"],
            "properties": { "policy": { "enum": ["none", "on_site"] } }
          },
          "then": { "properties": { "transferDueDays": false } }
        }
      ]
    },
    "cancellation": {
      "description": "Progi zwrotu „co najmniej N dni przed początkiem → % zwrotu”, od najdłuższego wyprzedzenia, zapisywane w migawce rezerwacji (ADR-072 §8). appliesTo to przełącznik oferty „Progi zwrotu obejmują też dopłatę”, który firma czyta i zmienia przez API (decyzja właściciela 28a): deposit — wyłączony, progi dotyczą tylko zadatku, a dopłata wraca w całości (domyślnie, w Noclegu); paid — włączony, progi dotyczą wszystkich wpłat. Bez zadatku (transfer, full) progi obejmują całą wpłatę: paid.",
      "type": "object",
      "additionalProperties": false,
      "required": ["appliesTo", "refunds"],
      "properties": {
        "appliesTo": { "enum": ["deposit", "paid"] },
        "refunds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minDaysBefore", "refundPercent"],
            "properties": {
              "minDaysBefore": {
                "type": "integer",
                "minimum": 0,
                "maximum": 365
              },
              "refundPercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "mandatory", "labels"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "enum": ["text", "number", "choice", "date", "consent"] },
        "mandatory": { "type": "boolean" },
        "labels": { "$ref": "#/$defs/localizedText" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/option" }
        }
      },
      "if": { "properties": { "type": { "const": "choice" } } },
      "then": { "required": ["options"], "properties": { "options": {} } },
      "else": { "properties": { "options": false } }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "labels"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "labels": { "$ref": "#/$defs/localizedText" }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "basis", "mandatory", "labels"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "basis": {
          "enum": [
            "per_booking",
            "per_time_unit",
            "per_person",
            "per_person_per_time_unit"
          ]
        },
        "mandatory": { "type": "boolean" },
        "labels": { "$ref": "#/$defs/localizedText" }
      }
    }
  }
}
