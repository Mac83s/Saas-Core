{
  "id": "shared.commerce",
  "layer": "shared",
  "version": 1,
  "dependsOn": [
    "core.organizations",
    "shared.billing",
    "shared.customers",
    "shared.notifications"
  ],
  "backend": {
    "djangoApp": "saas_core.modules.shared.commerce",
    "urlPrefix": "/api/v1/commerce",
    "permissions": ["commerce.orders.read", "commerce.payments.manage"],
    "roleGrants": {
      "manager": ["commerce.orders.read", "commerce.payments.manage"],
      "admin": ["commerce.orders.read", "commerce.payments.manage"],
      "owner": ["commerce.orders.read", "commerce.payments.manage"]
    },
    "entitlements": ["commerce.enabled"],
    "beatSchedule": {
      "commerce-expire-due-payments": {
        "task": "saas_core.modules.shared.commerce.tasks.expire_due_payments",
        "schedule": 60
      }
    },
    "eventSchemas": [],
    "publicTables": [],
    "platformTables": []
  },
  "frontend": {
    "routes": ["/panel/orders"],
    "navigation": ["orders"],
    "translationNamespaces": ["Orders"]
  }
}
