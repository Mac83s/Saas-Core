{
  "id": "shared.translation",
  "layer": "shared",
  "version": 1,
  "dependsOn": [
    "core.organizations",
    "shared.billing",
    "shared.notifications",
    "shared.model-port"
  ],
  "backend": {
    "djangoApp": "saas_core.modules.shared.translation",
    "urlPrefix": "/api/v1/translation",
    "permissions": ["translation.request", "translation.manage"],
    "roleGrants": {
      "manager": ["translation.request"],
      "admin": ["translation.request", "translation.manage"],
      "owner": ["translation.request", "translation.manage"]
    },
    "entitlements": [],
    "eventSchemas": [],
    "publicTables": [],
    "platformTables": [],
    "beatSchedule": {
      "translation-reconcile": {
        "task": "saas_core.modules.shared.translation.tasks.reconcile_translation_jobs",
        "schedule": 60
      },
      "translation-demand": {
        "task": "saas_core.modules.shared.translation.tasks.run_translation_demand",
        "schedule": 60
      },
      "translation-review-digest": {
        "task": "saas_core.modules.shared.translation.tasks.notify_translation_reviews",
        "schedule": 86400
      }
    }
  },
  "frontend": {
    "routes": [],
    "navigation": [],
    "translationNamespaces": []
  }
}
