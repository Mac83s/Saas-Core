{
  "id": "shared.sites",
  "layer": "shared",
  "version": 1,
  "dependsOn": ["core.organizations", "shared.billing", "shared.notifications"],
  "backend": {
    "djangoApp": "saas_core.modules.shared.sites",
    "urlPrefix": "/api/v1/sites",
    "permissions": [
      "site.content.edit",
      "site.publish",
      "sites.inquiry.submit"
    ],
    "entitlements": ["sites.enabled", "custom_domain.enabled"],
    "eventSchemas": ["sites.site.published.v1"],
    "publicTables": [
      "sites_domain",
      "sites_site",
      "sites_publication",
      "sites_contentcollection",
      "sites_contententry",
      "sites_contententrypublication"
    ],
    "platformTables": []
  },
  "frontend": {
    "routes": ["/sites"],
    "navigation": ["sites"],
    "translationNamespaces": ["sites"]
  }
}
