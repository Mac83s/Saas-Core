{
  "id": "shared.notifications",
  "layer": "shared",
  "version": 1,
  "dependsOn": ["core.organizations", "shared.billing"],
  "backend": {
    "djangoApp": "saas_core.modules.shared.notifications",
    "urlPrefix": "/api/v1/notifications",
    "permissions": [
      "notifications.preferences",
      "notifications.manage",
      "notifications.support",
      "integrations.manage"
    ],
    "entitlements": ["notifications.enabled"],
    "eventSchemas": [
      "notifications.message.queued.v1",
      "notifications.message.status.v1",
      "sites.site.published.v1"
    ],
    "publicTables": [],
    "platformTables": []
  },
  "frontend": {
    "routes": [
      "/panel/notifications",
      "/panel/integrations",
      "/panel/support/notifications"
    ],
    "navigation": ["settings.notifications", "settings.integrations"],
    "translationNamespaces": ["notifications"]
  }
}
