{
  "id": "shared.booking",
  "layer": "shared",
  "version": 1,
  "dependsOn": [
    "core.organizations",
    "shared.customers",
    "shared.notifications",
    "shared.profiles"
  ],
  "backend": {
    "djangoApp": "saas_core.modules.shared.booking",
    "urlPrefix": "/api/v1/booking",
    "permissions": [
      "booking.appointment.read",
      "booking.appointment.manage",
      "booking.schedule.own",
      "booking.staff.performance.read"
    ],
    "roleGrants": {
      "staff": ["booking.schedule.own"],
      "admin": ["booking.staff.performance.read"],
      "owner": ["booking.staff.performance.read"]
    },
    "entitlements": ["booking.enabled"],
    "eventSchemas": ["booking.appointment.created.v1"],
    "publicTables": [],
    "platformTables": []
  },
  "frontend": {
    "routes": ["/calendar"],
    "navigation": ["calendar"],
    "translationNamespaces": ["booking"]
  }
}
