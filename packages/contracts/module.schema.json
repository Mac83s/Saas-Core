{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas-core.local/schemas/module.schema.json",
  "title": "SaaS Core module descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "layer", "version", "dependsOn", "backend", "frontend"],
  "$defs": {
    "kindText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "kindOptionLabels": {
      "type": "object",
      "required": ["pl", "en"],
      "properties": {
        "pl": { "$ref": "#/$defs/kindOptionText" },
        "en": { "$ref": "#/$defs/kindOptionText" }
      },
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "$ref": "#/$defs/kindOptionText" }
    },
    "kindOptionText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "kindLabels": {
      "type": "object",
      "required": ["pl", "en"],
      "properties": {
        "pl": { "$ref": "#/$defs/kindText" },
        "en": { "$ref": "#/$defs/kindText" }
      },
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "$ref": "#/$defs/kindText" }
    },
    "kindField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "mandatory", "labels"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 40
        },
        "type": { "enum": ["text", "long_text", "number", "choice", "date"] },
        "mandatory": { "type": "boolean" },
        "mandatoryForStaff": { "type": "boolean" },
        "labels": { "$ref": "#/$defs/kindLabels" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "labels"],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 40
              },
              "labels": { "$ref": "#/$defs/kindOptionLabels" }
            }
          }
        }
      },
      "if": { "properties": { "type": { "const": "choice" } } },
      "then": { "required": ["options"], "properties": { "options": {} } },
      "else": { "properties": { "options": false } }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(core|shared|vertical|config)\\.[a-z][a-z0-9-]*$"
    },
    "layer": {
      "enum": ["core", "shared", "vertical", "config"]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(core|shared|vertical|config)\\.[a-z][a-z0-9-]*$"
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "djangoApp",
        "urlPrefix",
        "permissions",
        "entitlements",
        "eventSchemas",
        "publicTables",
        "platformTables"
      ],
      "properties": {
        "djangoApp": {
          "type": ["string", "null"]
        },
        "urlPrefix": {
          "type": ["string", "null"]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "entitlements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "eventSchemas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "publicTables": {
          "description": "Tables the public renderer reads without a tenant context; every other tenant table carries forced RLS (ADR-039).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$"
          },
          "uniqueItems": true
        },
        "platformTables": {
          "description": "Tables whose rows name an organization but belong to the platform, not to that tenant: written before a tenant is known (ADR-041), or written on the module's own connection with a bare organization_id erased through register_erasure_rows (ADR-068).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$"
          },
          "uniqueItems": true
        },
        "roleGrants": {
          "description": "Permissions this module adds to each system role. The module's own migration grants them in the database (ADR-049).",
          "type": "object",
          "propertyNames": {
            "enum": ["viewer", "staff", "manager", "admin", "owner"]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "appointmentKinds": {
          "description": "Kinds of visit this module adds to booking, as {key: label} (ADR-049).",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "appointmentKindsWithOwnMaterials": {
          "description": "Of this module's appointmentKinds, those whose materials the module accounts for itself (e.g. per animal in field work): booking neither takes products for them nor settles them at completion (ADR-055).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "appointmentKindsCompletedExplicitly": {
          "description": "Of this module's appointmentKinds, those that took place only once completed (the module closes them, e.g. when field work ends): a visit of such a kind whose time passed without completion is not counted as done (UX-031). \"\" names the plain service without a kind, for a product whose every visit is closed that way.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "appointmentKindFields": {
          "description": "Of this module's appointmentKinds, the booking-form fields each one brings, as {kind: [field]}. The core copies them onto every service of that kind when the service is created, the way a preset's fields are copied (ADR-072 §10), and `manage.py booking_apply_kind_fields` adds them to services that exist. A field has the shape of a booking preset's field (booking-presets/booking-preset.v1.schema.json, checked against it by a contract test); a consent is refused, since its wording is the company's.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/kindField"
            }
          }
        },
        "appointmentsOfOthersPermission": {
          "description": "A permission this module declares that opens other people's visits (UX-023). Without it, whoever does not plan visits (booking.appointment.manage) sees only the visits they are on — e.g. a doctor does not see another doctor's patients. Left out: everyone who reads the calendar sees everyone's visits.",
          "type": "string",
          "minLength": 1
        },
        "middleware": {
          "description": "Middleware classes of this module, mounted after the tenant middleware only where the module is composed (ADR-049). Must live in the module's own app.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "beatSchedule": {
          "description": "Scheduled work of this module as {name: {task, schedule}}; schedule in seconds (ADR-049). Tasks must live in the module's own app.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task", "schedule"],
            "properties": {
              "task": {
                "type": "string",
                "minLength": 1
              },
              "schedule": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes", "navigation", "translationNamespaces"],
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "navigation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "translationNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
