{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas-core.local/schemas/module.schema.json",
  "title": "SaaS Core module descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "layer", "version", "dependsOn", "backend", "frontend"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(core|shared|vertical|config)\\.[a-z][a-z0-9-]*$"
    },
    "layer": {
      "enum": ["core", "shared", "vertical", "config"]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(core|shared|vertical|config)\\.[a-z][a-z0-9-]*$"
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "djangoApp",
        "urlPrefix",
        "permissions",
        "entitlements",
        "eventSchemas",
        "publicTables",
        "platformTables"
      ],
      "properties": {
        "djangoApp": {
          "type": ["string", "null"]
        },
        "urlPrefix": {
          "type": ["string", "null"]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "entitlements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "eventSchemas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "publicTables": {
          "description": "Tables the public renderer reads without a tenant context; every other tenant table carries forced RLS (ADR-039).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$"
          },
          "uniqueItems": true
        },
        "platformTables": {
          "description": "Tables whose rows name an organization but belong to the platform, not to that tenant, and are written before a tenant is known (ADR-041).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$"
          },
          "uniqueItems": true
        },
        "roleGrants": {
          "description": "Permissions this module adds to each system role. The module's own migration grants them in the database (ADR-049).",
          "type": "object",
          "propertyNames": {
            "enum": ["viewer", "staff", "manager", "admin", "owner"]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "appointmentKinds": {
          "description": "Kinds of visit this module adds to booking, as {key: label} (ADR-049).",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "appointmentKindsWithOwnMaterials": {
          "description": "Of this module's appointmentKinds, those whose materials the module accounts for itself (e.g. per animal in field work): booking neither takes products for them nor settles them at completion (ADR-055).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "middleware": {
          "description": "Middleware classes of this module, mounted after the tenant middleware only where the module is composed (ADR-049). Must live in the module's own app.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "beatSchedule": {
          "description": "Scheduled work of this module as {name: {task, schedule}}; schedule in seconds (ADR-049). Tasks must live in the module's own app.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task", "schedule"],
            "properties": {
              "task": {
                "type": "string",
                "minLength": 1
              },
              "schedule": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes", "navigation", "translationNamespaces"],
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "navigation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "translationNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
