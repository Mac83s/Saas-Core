{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas-core.local/schemas/module.schema.json",
  "title": "SaaS Core module descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "layer", "version", "dependsOn", "backend", "frontend"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(core|shared|vertical|config)\\.[a-z][a-z0-9-]*$"
    },
    "layer": {
      "enum": ["core", "shared", "vertical", "config"]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(core|shared|vertical|config)\\.[a-z][a-z0-9-]*$"
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "djangoApp",
        "urlPrefix",
        "permissions",
        "entitlements",
        "eventSchemas",
        "publicTables",
        "platformTables"
      ],
      "properties": {
        "djangoApp": {
          "type": ["string", "null"]
        },
        "urlPrefix": {
          "type": ["string", "null"]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "entitlements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "eventSchemas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "publicTables": {
          "description": "Tables the public renderer reads without a tenant context; every other tenant table carries forced RLS (ADR-039).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$"
          },
          "uniqueItems": true
        },
        "platformTables": {
          "description": "Tables whose rows name an organization but belong to the platform, not to that tenant, and are written before a tenant is known (ADR-041).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes", "navigation", "translationNamespaces"],
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "navigation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "translationNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
