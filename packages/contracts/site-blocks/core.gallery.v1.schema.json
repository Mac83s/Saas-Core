{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saas-core.local/site-blocks/core.gallery.v1.schema.json",
  "title": "Core gallery block v1",
  "description": "Photos with titles and captions (F4-P3): a photo story, a captioned grid, one dominant photo with details, photos woven into text, a project mosaic, steps in photos. No script and no carousel. A photo is optional, so a gallery can be laid out before the pictures exist; an item is never empty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "layout": {
      "type": "string",
      "enum": [
        "photo_story",
        "captioned_grid",
        "dominant_details",
        "interleaved",
        "project_mosaic",
        "photo_steps"
      ],
      "default": "captioned_grid"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "lead": {
      "type": "string",
      "maxLength": 600
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset_id", "alt"],
            "properties": {
              "asset_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "link": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "href"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "href": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^(?:/(?!/)|https://|mailto:|tel:|#[a-z][a-z0-9-]{0,63}$)"
              }
            }
          }
        },
        "minProperties": 1
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "href": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:/(?!/)|https://|mailto:|tel:|#[a-z][a-z0-9-]{0,63}$)"
        }
      }
    }
  }
}
