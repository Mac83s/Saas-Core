{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saas-core.local/site-blocks/core.hero.v5.schema.json",
  "title": "Core hero block v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "text": {
      "type": "string",
      "maxLength": 600
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "alt"],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "href": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:/|https://|mailto:|tel:)"
        }
      }
    },
    "layout": {
      "type": "string",
      "enum": [
        "classic",
        "centered",
        "split",
        "split_reverse",
        "image_above",
        "banner",
        "overlay_left",
        "overlay_center",
        "editorial",
        "inset",
        "framed",
        "portrait",
        "spotlight",
        "sidebar",
        "poster",
        "diagonal",
        "card",
        "floating",
        "compact",
        "magazine"
      ],
      "default": "classic"
    }
  }
}
