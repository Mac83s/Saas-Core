{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saas-core.local/site-blocks/core.quote.v1.schema.json",
  "title": "Core editorial quote block v1",
  "description": "A cited statement with its author and source. Not a customer review: it has no rating and no invented endorsement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["quote"],
  "properties": {
    "layout": {
      "type": "string",
      "enum": ["portrait"]
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "role": {
      "type": "string",
      "maxLength": 160
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "href": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:/(?!/)|https://|mailto:|tel:)"
        }
      }
    },
    "context": {
      "type": "string",
      "maxLength": 1200
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "alt"],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
