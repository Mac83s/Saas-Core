{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saas-core.local/site-blocks/core.feature_list.v5.schema.json",
  "title": "Core feature_list block v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "lead": {
      "type": "string",
      "maxLength": 1200
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "maxLength": 1200
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "values": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "first": {
                "type": "string",
                "maxLength": 300
              },
              "second": {
                "type": "string",
                "maxLength": 300
              },
              "third": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "layout": {
      "type": "string",
      "enum": [
        "classic",
        "cards",
        "columns",
        "care_path",
        "consultation",
        "field_steps",
        "coverage",
        "specification",
        "service_flow",
        "image_left",
        "image_right",
        "image_top",
        "numbered",
        "timeline",
        "alternating",
        "bento",
        "strip",
        "checklist",
        "compact",
        "divided",
        "spotlight",
        "stacked",
        "chips",
        "magazine",
        "tiles",
        "editorial",
        "steps_notes",
        "benefits_commentary",
        "scope_comparison",
        "shared_roles",
        "scope_limits",
        "staged_preparation",
        "instruction_notes",
        "fit_check"
      ],
      "default": "classic"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "alt"],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "href": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:/(?!/)|https://|mailto:|tel:|#[a-z][a-z0-9-]{0,63}$)"
        }
      }
    }
  }
}
