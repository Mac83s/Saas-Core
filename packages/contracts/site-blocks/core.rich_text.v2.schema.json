{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saas-core.local/site-blocks/core.rich_text.v2.schema.json",
  "title": "Core rich text block v2",
  "description": "Structured editorial content. Stored as JSON nodes, never HTML or Markdown. Inline runs carry only bold, italic and an allowlisted link. Headings carry a stable, explicit anchor that editing the heading text never changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["content"],
  "properties": {
    "layout": {
      "type": "string",
      "enum": ["column", "split_intro", "facts_panel", "chapters"],
      "default": "column"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "lead": {
      "type": "string",
      "maxLength": 1200
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 160,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/paragraph"
          },
          {
            "$ref": "#/$defs/heading"
          },
          {
            "$ref": "#/$defs/list"
          },
          {
            "$ref": "#/$defs/quote"
          },
          {
            "$ref": "#/$defs/note"
          },
          {
            "$ref": "#/$defs/figure"
          }
        ]
      }
    },
    "aside": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/paragraph"
              },
              {
                "$ref": "#/$defs/list"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "bold": {
          "const": true
        },
        "italic": {
          "const": true
        },
        "href": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:/(?!/)|https://|mailto:|tel:|#[a-z][a-z0-9-]{0,63}$)"
        }
      }
    },
    "inline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/span"
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "anchor", "text"],
      "properties": {
        "type": {
          "const": "heading"
        },
        "level": {
          "enum": [2, 3, 4]
        },
        "anchor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": {
          "$ref": "#/$defs/inline"
        },
        "children": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "items"],
          "properties": {
            "style": {
              "enum": ["bullet", "ordered"]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["content"],
                "properties": {
                  "content": {
                    "$ref": "#/$defs/inline"
                  }
                }
              }
            }
          }
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "style", "items"],
      "properties": {
        "type": {
          "const": "list"
        },
        "style": {
          "enum": ["bullet", "ordered"]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/listItem"
          }
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "const": "quote"
        },
        "content": {
          "$ref": "#/$defs/inline"
        },
        "author": {
          "type": "string",
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "href": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:/(?!/)|https://|mailto:|tel:)"
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "const": "note"
        },
        "tone": {
          "enum": ["info", "tip", "warning"]
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "image"],
      "properties": {
        "type": {
          "const": "figure"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_id", "alt"],
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "caption": {
          "type": "string",
          "maxLength": 300
        },
        "width": {
          "enum": ["column", "wide"]
        }
      }
    }
  }
}
