{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saas-core.local/site-blocks/core.rich_text.v4.schema.json",
  "title": "Core rich text block v4",
  "description": "Structured editorial content. Stored as JSON nodes, never HTML or Markdown. Inline runs carry only bold, italic and an allowlisted link, which may say how it vouches for its target (`rel`, ADR-061). Headings carry a stable, explicit anchor that editing the heading text never changes. v3 adds an optional call to action (primary and secondary), an eyebrow label, a side photograph and an author card, and sixteen editorial layouts designed around one reader decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["content"],
  "properties": {
    "layout": {
      "type": "string",
      "enum": [
        "column",
        "split_intro",
        "facts_panel",
        "chapters",
        "lead_statement",
        "two_parts",
        "side_photo",
        "panorama",
        "illustrated",
        "margin_quote",
        "summary_box",
        "expert_note",
        "alternating_chapters",
        "timeline",
        "numbered_sections",
        "manifesto",
        "problem_solution",
        "howto",
        "resources",
        "essay_cta"
      ],
      "default": "column"
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "lead": {
      "type": "string",
      "maxLength": 1200
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 160,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/paragraph"
          },
          {
            "$ref": "#/$defs/heading"
          },
          {
            "$ref": "#/$defs/list"
          },
          {
            "$ref": "#/$defs/quote"
          },
          {
            "$ref": "#/$defs/note"
          },
          {
            "$ref": "#/$defs/figure"
          }
        ]
      }
    },
    "aside": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/paragraph"
              },
              {
                "$ref": "#/$defs/list"
              }
            ]
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "alt"],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "caption": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "maxLength": 160
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_id", "alt"],
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "href": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:/(?!/)|https://|mailto:|tel:|#[a-z][a-z0-9-]{0,63}$)"
        }
      }
    },
    "secondaryAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "href": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:/(?!/)|https://|mailto:|tel:|#[a-z][a-z0-9-]{0,63}$)"
        }
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "bold": {
          "const": true
        },
        "italic": {
          "const": true
        },
        "href": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:/(?!/)|https://|mailto:|tel:|#[a-z][a-z0-9-]{0,63}$)"
        },
        "rel": {
          "description": "ADR-061: how the link vouches for its target. Absent means an editorial link.",
          "enum": ["sponsored", "ugc", "nofollow"]
        }
      },
      "dependentRequired": {
        "rel": ["href"]
      }
    },
    "inline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/span"
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "anchor", "text"],
      "properties": {
        "type": {
          "const": "heading"
        },
        "level": {
          "enum": [2, 3, 4]
        },
        "anchor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": {
          "$ref": "#/$defs/inline"
        },
        "children": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "items"],
          "properties": {
            "style": {
              "enum": ["bullet", "ordered"]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["content"],
                "properties": {
                  "content": {
                    "$ref": "#/$defs/inline"
                  }
                }
              }
            }
          }
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "style", "items"],
      "properties": {
        "type": {
          "const": "list"
        },
        "style": {
          "enum": ["bullet", "ordered"]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/listItem"
          }
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "const": "quote"
        },
        "content": {
          "$ref": "#/$defs/inline"
        },
        "author": {
          "type": "string",
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "href": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:/(?!/)|https://|mailto:|tel:)"
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "const": "note"
        },
        "tone": {
          "enum": ["info", "tip", "warning"]
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "image"],
      "properties": {
        "type": {
          "const": "figure"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_id", "alt"],
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "caption": {
          "type": "string",
          "maxLength": 300
        },
        "width": {
          "enum": ["column", "wide"]
        }
      }
    }
  }
}
