{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saas-core.local/site-blocks/core.link_list.v2.schema.json",
  "title": "Core link list block v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["links"],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "text": {
      "type": "string",
      "maxLength": 600
    },
    "layout": {
      "type": "string",
      "enum": ["buttons", "icons", "cards", "list", "split", "band"],
      "default": "buttons"
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "href"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "href": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^(?:/(?!/)|https://|mailto:|tel:)"
          },
          "description": {
            "type": "string",
            "maxLength": 240
          },
          "rel": {
            "description": "ADR-061: how the link vouches for its target. Absent means an editorial link.",
            "enum": ["sponsored", "ugc", "nofollow"]
          }
        }
      }
    }
  }
}
