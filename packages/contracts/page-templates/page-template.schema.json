{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saas-core.local/page-templates/page-template.schema.json",
  "title": "SaaS Core page template recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "category", "labels", "blocks"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "version": { "type": "integer", "minimum": 1 },
    "category": { "enum": ["profile", "landing", "company"] },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pl", "en"],
      "properties": {
        "pl": { "$ref": "#/$defs/label" },
        "en": { "$ref": "#/$defs/label" }
      }
    },
    "requiredEntitlements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_type", "schema_version", "data"],
        "properties": {
          "block_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
          },
          "schema_version": { "type": "integer", "minimum": 1 },
          "data": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
