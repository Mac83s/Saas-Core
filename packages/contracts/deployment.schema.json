{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas-core.local/schemas/deployment.schema.json",
  "title": "SaaS Core deployment profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "product", "modules", "features"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "defaultLocale",
        "supportedLocales",
        "platformDomain"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "defaultLocale": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "supportedLocales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          }
        },
        "platformDomain": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(core|shared|vertical|config)\\.[a-z][a-z0-9-]*$"
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planKeys"],
      "properties": {
        "planKeys": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": ["boolean", "string", "number"]
      }
    },
    "organizationTypes": {
      "description": "Typy organizacji produktu (ADR-050). Pierwszy jest domyślny. Bez tej sekcji profil ma jeden typ `business` ze wszystkimi modułami i planami profilu.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "modules", "selfSignup"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 40
          },
          "label": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pl", "en"],
            "properties": {
              "pl": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pl", "en"],
            "properties": {
              "pl": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "modules": {
            "description": "Moduły shared/vertical dostępne organizacji tego typu; moduły core ma każda.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(shared|vertical)\\.[a-z][a-z0-9-]*$"
            }
          },
          "planKeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "selfSignup": {
            "description": "Czy użytkownik może sam założyć organizację tego typu.",
            "type": "boolean"
          },
          "roles": {
            "description": "Role systemowe typu (ADR-050). Wymagane role owner i admin. Bez tej listy typ używa ról globalnych rdzenia.",
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label", "permissions"],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64
                },
                "label": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pl", "en"],
                  "properties": {
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "permissions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "limited": {
                  "description": "Rolę może nadać osoba z ograniczonym zarządzaniem członkami (np. kierownik).",
                  "type": "boolean"
                }
              }
            }
          },
          "serviceTemplates": {
            "description": "Szablony usług rezerwacji typu (ADR-050): gotowe usługi do założenia jednym kliknięciem.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label", "durationMinutes"],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pl", "en"],
                  "properties": {
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "durationMinutes": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 1440
                },
                "appointmentKind": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "modules": {
            "type": "array",
            "contains": {
              "const": "shared.billing"
            }
          }
        },
        "required": ["modules"]
      },
      "then": {
        "properties": {
          "billing": {}
        },
        "required": ["billing"]
      }
    }
  ]
}
