{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas-core.local/schemas/deployment.schema.json",
  "title": "SaaS Core deployment profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "product", "modules", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "defaultLocale",
        "supportedLocales",
        "platformDomain"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "defaultLocale": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "supportedLocales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
        },
        "platformDomain": { "type": "string", "minLength": 3 }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(core|shared|vertical|config)\\.[a-z][a-z0-9-]*$"
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planKeys"],
      "properties": {
        "planKeys": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": ["boolean", "string", "number"] }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "modules": {
            "type": "array",
            "contains": { "const": "shared.billing" }
          }
        },
        "required": ["modules"]
      },
      "then": {
        "properties": { "billing": {} },
        "required": ["billing"]
      }
    }
  ]
}
