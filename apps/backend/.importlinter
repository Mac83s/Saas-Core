[importlinter]
root_package = saas_core

[importlinter:contract:module-layers]
name = Kierunek warstw modułów
type = layers
layers =
    saas_core.modules.config
    saas_core.modules.vertical
    saas_core.modules.shared
    saas_core.modules.core

[importlinter:contract:content-protocol-pure]
name = Protokół treści nie zna modułów ani konfiguracji
type = forbidden
source_modules =
    saas_core.content_protocol
forbidden_modules =
    saas_core.modules
    saas_core.config

[importlinter:contract:testing-stays-in-tests]
name = Pomocniki testów (saas_core.testing) nie trafiają do kodu aplikacji
type = forbidden
source_modules =
    saas_core.modules
    saas_core.config
    saas_core.content_protocol
    saas_core.http
    saas_core.observability
forbidden_modules =
    saas_core.testing

[importlinter:contract:content-modules-without-engine]
name = Moduły treści nie zależą od silnika tłumaczeń (ADR-069 pkt 1, translation-sources.md §1)
type = forbidden
source_modules =
    saas_core.modules.shared.sites
    saas_core.modules.shared.profiles
    saas_core.modules.shared.booking
    saas_core.modules.vertical
forbidden_modules =
    saas_core.modules.shared.translation

[importlinter:contract:model-port-alone]
name = Port modeli nie zależy od innych modułów shared (ADR-068 pkt 1)
type = forbidden
source_modules =
    saas_core.modules.shared.model_port
forbidden_modules =
    saas_core.modules.shared.billing
    saas_core.modules.shared.booking
    saas_core.modules.shared.farms
    saas_core.modules.shared.image_generation
    saas_core.modules.shared.inventory
    saas_core.modules.shared.media
    saas_core.modules.shared.notifications
    saas_core.modules.shared.profiles
    saas_core.modules.shared.seo
    saas_core.modules.shared.sites
