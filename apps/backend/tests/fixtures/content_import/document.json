      "versions": [
        {
          "locale": "pl",
          "title": "Jak czesać psa, żeby to lubił",
          "excerpt": "Szczotka, kolejność i nagrody: czesanie w dziesięć minut.",
          "slug": "jak-czesac-psa",
          "former_slugs": [
            "czesanie-psa",
            "czesanie"
          ],
          "body": {
            "html": "<h2>Jak <a href=\"https://example.com/szczotki\">wybrać szczotkę</a></h2><p>Czesz psa <u>regularnie</u>, najlepiej <b>co tydzień</b>. Zobacz też <a href=\"/poradnik/kapiel-psa/\">kąpiel psa</a>.</p><img src=\"https://stary-serwis.example/img/szczotka.png\"><table><tr><th>Sierść</th><th>Jak często</th></tr><tr><td>Krótka</td><td>raz w tygodniu</td></tr><tr><td colspan=\"2\">Długa — co dwa dni</td></tr></table><h1>Na koniec</h1><p>Nagroda po każdym czesaniu.</p>"
          },
          "cover": {
            "file": "pictures/okladka-czesanie.jpg",
            "alt": "Pies czesany szczotką"
          },
          "images": {
            "https://stary-serwis.example/img/szczotka.png": {
              "file": "pictures/szczotka.png",
              "alt": "Szczotka do długiej sierści"
            }
          },
          "accept_losses": [
            "heading_link_dropped"
          ],
          "status": "published",
          "published_at": "2023-03-14T08:30:00+01:00",
          "changed_at": "2025-02-01T10:00:00+01:00",
          "origin": "human"
        },
        {
          "locale": "en",
          "title": "How to brush a dog so it likes it",
          "slug": "how-to-brush-a-dog",
          "former_slugs": [
            "brushing-a-dog"
          ],
          "body": {
            "html": "<h2>How to choose a brush</h2><p>Brush your dog <b>every week</b>. See also <a href=\"/en/guide/bathing-a-dog/\">bathing a dog</a>.</p><img src=\"https://stary-serwis.example/img/szczotka.png\" alt=\"A brush for long coats\"><table><tr><th>Coat</th><th>How often</th></tr><tr><td>Short</td><td>once a week</td></tr><tr><td>Long</td><td>every other day</td></tr></table><h2>One last thing</h2><p>A treat after every brushing.</p>"
          },
          "cover": {
            "file": "pictures/okladka-czesanie.jpg",
            "alt": "A dog being brushed"
