DJANGO_SETTINGS_MODULE=saas_core.config.settings.local
DJANGO_SECRET_KEY=replace-in-non-local-environments
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DEFAULT_FROM_EMAIL=SaaS Core <noreply@localhost>
DEPLOYMENT=core-only
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=.runtime/emails
FRONTEND_BASE_URL=http://localhost:3000
POSTGRES_DB=saas_core
POSTGRES_USER=saas_core
POSTGRES_PASSWORD=saas_core
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_COOKIE_NAME=saas_core_dev_session
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=86400
TENANT_TASK_CONTEXT_TTL_SECONDS=86400
ORGANIZATION_INVITATION_TTL_SECONDS=604800
TRUSTED_PROXY_COUNT=0
