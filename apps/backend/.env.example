DJANGO_SETTINGS_MODULE=saas_core.config.settings.local
DJANGO_SECRET_KEY=replace-in-non-local-environments
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DEFAULT_FROM_EMAIL=SaaS Core <noreply@localhost>
DEPLOYMENT=core-only
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=.runtime/emails
FRONTEND_BASE_URL=http://localhost:3000
POSTGRES_DB=saas_core
POSTGRES_USER=saas_core_app
POSTGRES_PASSWORD_FILE=.runtime/secrets/postgres_app_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:8333
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=http://127.0.0.1:8333
OBJECT_STORAGE_BUCKET=saas-core-local
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID_FILE=.runtime/secrets/object_storage_access_key_id
OBJECT_STORAGE_SECRET_ACCESS_KEY_FILE=.runtime/secrets/object_storage_secret_access_key
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_PROCESSING_RESERVATION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=saas_core_dev_session
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=86400
TENANT_TASK_CONTEXT_TTL_SECONDS=86400
ORGANIZATION_INVITATION_TTL_SECONDS=604800
TRUSTED_PROXY_COUNT=0
