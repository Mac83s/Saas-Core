DEPLOYMENT=core-only
BILLING_PROVIDER=simulated
# Wymagane dopiero przy BILLING_PROVIDER=stripe (W9.5.2S). Same klucze trafiają
# do plików w SAAS_CORE_SECRETS_DIR, nigdy do .env ani do repozytorium.
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_LIVEMODE=false
STRIPE_TAX_CODE=txcd_10000000
# Pusta wartość zostawia wersję przypiętą w kodzie.
STRIPE_API_VERSION=
SITES_RESERVED_SUBDOMAIN_LABELS=
SAAS_CORE_HTTP_PORT=8080
SAAS_CORE_GRAFANA_PORT=3001
SAAS_CORE_EMAILS_DIR=.runtime/emails
TRUSTED_PROXY_COUNT=1
SAAS_CORE_POSTGRES_PORT=5432
SAAS_CORE_POSTGRES_DB=saas_core
SAAS_CORE_POSTGRES_APP_USER=saas_core_app
SAAS_CORE_POSTGRES_MIGRATION_USER=saas_core
SAAS_CORE_REDIS_PORT=6379
SAAS_CORE_S3_PORT=8333
SAAS_CORE_SECRETS_DIR=.runtime/secrets
OBJECT_STORAGE_BUCKET=saas-core-local
OBJECT_STORAGE_REGION=us-east-1
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_PROCESSING_RESERVATION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=saas_core_local_session
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=86400
TENANT_TASK_CONTEXT_TTL_SECONDS=3888000
NOTIFICATIONS_RETENTION_DAYS=30
NOTIFICATIONS_EXPORT_TTL_HOURS=24
NOTIFICATIONS_EXPORT_MAX_ROWS=10000
NOTIFICATIONS_WEBHOOK_TOLERANCE_SECONDS=300
ORGANIZATION_INVITATION_TTL_SECONDS=604800
BILLING_LIFECYCLE_WARNING_LEAD_SECONDS=86400
BILLING_LIFECYCLE_MAX_ATTEMPTS=5
BILLING_RECONCILIATION_INTERVAL_SECONDS=3600
BILLING_RECONCILIATION_MAX_ATTEMPTS=5
BILLING_RECONCILIATION_BATCH_SIZE=100
BILLING_INVOICE_ADAPTER=saas_core.modules.shared.billing.invoicing.InternalInvoiceAdapter

# Optional SSA audit integration; empty configuration disables ordering.
# Secrets belong in SAAS_CORE_SECRETS_DIR/seo_ssa_service_key and seo_ssa_callback_secret.
SEO_SSA_BASE_URL=
SEO_SSA_SOURCE_ID=
SEO_SSA_PRODUCT_ID=
SEO_SSA_DEPLOYMENT_ID=
SEO_AUDIT_CREDIT_OPERATION=
SEO_AUDIT_MAX_PAGES=100
SEO_REPORT_MAX_ISSUES=5000
