APP_ENV=staging
DEPLOYMENT=medplano
ALLOWED_HOSTS=staging.example.com
ACME_EMAIL=ops@example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com
DEFAULT_FROM_EMAIL=SaaS Core <noreply@staging.example.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=smtp-user
EMAIL_PORT=587
EMAIL_USE_TLS=true
FRONTEND_BASE_URL=https://staging.example.com
LOG_LEVEL=INFO
SAAS_CORE_IMAGE_TAG=sha-replace-with-commit
SAAS_CORE_IMAGE_PREFIX=ghcr.io/example/saas-core
SAAS_CORE_LOGS_DIR=/opt/saas-core/logs
SAAS_CORE_POSTGRES_DB=saas_core
SAAS_CORE_SECRETS_DIR=/opt/saas-core/secrets
SESSION_COOKIE_NAME=saas_core_medplano_session
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=86400
TENANT_TASK_CONTEXT_TTL_SECONDS=86400
ORGANIZATION_INVITATION_TTL_SECONDS=604800
STAGING_HOST=staging.example.com
TRUSTED_PROXY_COUNT=1
