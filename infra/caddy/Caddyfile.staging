{
	admin off
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	metrics
	on_demand_tls {
		ask http://backend:8000/internal/caddy/domains/authorize/
	}
}

(app_routes) {
    log_skip /api/v1/seo/gsc/callback/
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	header {
		-Server
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# The public catalogue's "Blisko mnie" asks the browser for its location
	# (ADR-064 §7); every other page keeps geolocation off. The two matchers
	# exclude each other, so the order of the directives does not matter.
	# Any language prefix (TL20): /katalog, /en/katalog, /de/katalog …
	@catalog path_regexp ^/([a-z]{2}/)?katalog(/.*)?$
	@notCatalog not path_regexp ^/([a-z]{2}/)?katalog(/.*)?$
	header @catalog Permissions-Policy "camera=(), geolocation=(self), microphone=()"
	header @notCatalog Permissions-Policy "camera=(), geolocation=(), microphone=()"

	# /internal/* is closed to the internet as a whole, not path by path: a list
	# of forbidden paths had already missed the operator admin, which had a
	# password-only login. Nothing legitimate comes this way — Prometheus scrapes
	# backend:8000 directly and the edge asks for TLS permission on its own
	# listener. It must be a `handle` written before `handle @api`: a bare
	# `respond` sorts after every `handle` and never runs, which is how the
	# metrics stayed public from 2026-08-12 to 2026-10-01.
	@private path /internal /internal/*
	handle @private {
		respond 404
	}

	@api path /api/* /internal/* /static/*
	handle @api {
		reverse_proxy backend:8000 {
			health_uri /api/v1/health/live/
			health_interval 10s
			health_timeout 2s
			lb_try_duration 2s
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			health_uri /healthz
			health_interval 10s
			health_timeout 2s
			lb_try_duration 2s
		}
	}

	log {
		output stdout
		format json
	}
}

{$STAGING_HOST} {
	import app_routes
}

https:// {
	tls {
		on_demand
	}
	import app_routes
}

:2019 {
	metrics
}
