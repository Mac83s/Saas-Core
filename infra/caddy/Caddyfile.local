{
	auto_https off
	admin off
	metrics
}

:8080 {
    log_skip /api/v1/seo/gsc/callback/
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	header {
		-Server
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# The public catalogue's "Blisko mnie" asks the browser for its location
	# (ADR-064 §7); every other page keeps geolocation off. The two matchers
	# exclude each other, so the order of the directives does not matter.
	# Any language prefix (TL20): /katalog, /en/katalog, /de/katalog …
	@catalog path_regexp ^/([a-z]{2}/)?katalog(/.*)?$
	@notCatalog not path_regexp ^/([a-z]{2}/)?katalog(/.*)?$
	header @catalog Permissions-Policy "camera=(), geolocation=(self), microphone=()"
	header @notCatalog Permissions-Policy "camera=(), geolocation=(), microphone=()"

	# Locally /internal/* stays open on purpose: the operator admin is a
	# developer tool here, and scripts/observability-smoke.mjs reads
	# /internal/metrics/ through this listener. The public Caddyfiles close it.

	@api path /api/* /internal/* /static/*
	handle @api {
		reverse_proxy backend:8000 {
			health_uri /api/v1/health/live/
			health_interval 10s
			health_timeout 2s
			lb_try_duration 2s
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			health_uri /healthz
			health_interval 10s
			health_timeout 2s
			lb_try_duration 2s
		}
	}

	log {
		output stdout
		format json
	}
}

:2019 {
	metrics
}
